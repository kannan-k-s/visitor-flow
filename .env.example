# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# This file documents required environment variables with NO real secrets.

# ── Application ──────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ── MySQL (source of truth) ──────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=visitorflow
MYSQL_USERNAME=visitorflow
MYSQL_PASSWORD=change-me

# ── Redis (config cache, result counters, rate-limit buckets) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka (async tracking / streaming) ───────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Google OAuth (control-plane console login) ───────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── LLM provider (variant content generation — backend only) ─
# Key lives ONLY on the backend generator, never in the browser/snippet.
LLM_API_KEY=
LLM_BASE_URL=

# ── Security ─────────────────────────────────────────────────
# Secret used to hash tenant API keys at rest.
API_KEY_HASH_SECRET=change-me
