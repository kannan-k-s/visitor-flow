# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Only secrets belong here; non-secret settings live in application.properties.

# MySQL
MYSQL_PASSWORD=change-me

# RabbitMQ
RABBITMQ_PASSWORD=change-me

# Google OAuth
GOOGLE_OAUTH_CLIENT_SECRET=

# JWT signing key (at least 32 bytes)
JWT_SIGNING_SECRET=replace-with-at-least-32-byte-secret
